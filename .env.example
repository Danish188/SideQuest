# Server-side only. Never prefix this with VITE_: anything VITE_* is inlined into
# the browser bundle and would publish your key to every visitor.
#
# Local (wrangler pages dev):  copy to .dev.vars
# Cloudflare:  Pages project, Settings, Variables and Secrets, add as a Secret
# Vercel:      Project Settings, Environment Variables
OPENAI_API_KEY=sk-...
