{
  // An explicit config is what stops `wrangler deploy` guessing.
  //
  // Without this file wrangler falls back to framework auto-detection, spots Vite,
  // and tries to apply the Cloudflare Vite plugin, which requires Vite 6 or newer.
  // That is what failed the build on Vite 5. Declaring `main` and `assets` here
  // means wrangler deploys exactly what we say and never runs that path.
  "name": "sidequest",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Left as "none" on purpose. "single-page-application" would serve index.html
    // for every miss, including a missing /assets/*.js, which hands the browser
    // HTML where it expects a module and blanks the page. worker/index.ts does the
    // SPA fallback instead, for document requests only.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
